        "file": "public/sample.html",
        "contains": [
          "<body id=\"top\">",
          "<main id=\"content\">",
          "<!--smol:authored-content-->",
          "<nav aria-label=\"Page navigation\">",
          "<!--smol:generated-navigation-->",
          "<a href=\"#top\" rel=\"top\">Top</a>",
          "<a href=\"index.html\" rel=\"home\">Home</a>",
          "<a href=\"about.html\" rel=\"up\">Up: About</a>",
          "<a href=\"index.html\" rel=\"previous\">Previous: Home</a>",
          "<a href=\"about.html\" rel=\"related\">Related: About</a>"
        ],
        "not_contains": [
          "href=\"/\"",
          "SMOL ATTESTED MANIFEST V1"
        ]
      }
    ]
  },
  {
    "name": "explicit-navigation-gemini",
