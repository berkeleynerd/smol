[
  {
    "name": "explicit-navigation-default-html",
    "output_mode": "",
    "action": "check",
    "expect": "pass",
    "starter": "default",
    "fixture": "valid/explicit-navigation-default-html",
    "assertions": [
      {
        "file": "public/about/index.html",
        "contains": [
          "<body id=\"top\">",
          "<main id=\"content\">",
          "<!--smol:authored-content-->",
          "<nav aria-label=\"Page navigation\">",
          "<!--smol:generated-navigation-->",
          "<a href=\"#top\" rel=\"top\">Top</a>",
          "<a href=\"../index.html\" rel=\"home\">Home</a>",
          "<a href=\"../sample/\" rel=\"next\">Next: Sample</a>",
          "<a href=\"../reference/\" rel=\"related\">Related: Reference</a>"
        ],
        "region": {
          "start": "<!--smol:authored-content-->",
          "end": "<!--/smol:authored-content-->",
          "contains": [
            "<p>About body.</p>"
          ],
          "not_contains": [
            "<!--smol:generated-navigation-->",
            "Next: Sample"
          ]
        },
        "not_contains": [
          "rel=\"up\""
        ]
      }
    ]
  },
