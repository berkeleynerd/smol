[
  {
    "name": "explicit-navigation-default-html",
    "output_mode": "",
    "action": "build",
    "expect": "pass",
    "starter": "default",
    "fixture": "valid/explicit-navigation-default-html",
    "assertions": [
      {
        "file": "public/about/index.html",
        "contains": [
          "<body id=\"top\">",
          "<main id=\"content\" data-smol-authored-content=\"true\">",
          "<nav data-smol-generated-chrome=\"navigation\" aria-label=\"Page navigation\">",
          "<a href=\"#top\" rel=\"top\">Top</a>",
          "<a href=\"../index.html\" rel=\"home\">Home</a>",
          "<a href=\"../index.html\" rel=\"up\">Up: Home</a>",
          "<a href=\"../sample/\" rel=\"next\">Next: Sample</a>",
          "<a href=\"../reference/\" rel=\"related\">Related: Reference</a>"
        ],
        "region": {
          "start": "<main id=\"content\" data-smol-authored-content=\"true\">",
          "end": "\n  </main>",
          "contains": [
            "<p>About body.</p>"
          ],
          "not_contains": [
            "data-smol-generated-chrome",
            "Next: Sample"
          ]
        }
      }
    ]
  },
